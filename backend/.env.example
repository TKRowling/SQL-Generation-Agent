# Application
APP_NAME=AskMe Web
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173
# Optional shared key checked through X-API-Key. Leave empty for no API-key check.
ASKME_API_KEY=
# Return generated SQL in API responses for debugging. Keep false in production.
EXPOSE_SQL=false
MAX_ROWS=50
MAX_HISTORY_TURNS=8
SCHEMA_CACHE_SECONDS=600

# Cloudflare Workers AI
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CF_AI_TEMPERATURE=0.1
CF_AI_TIMEOUT_SECONDS=60

# Local PostgreSQL
# Standard, short alias, and JDBC PostgreSQL URLs are accepted.
# Examples:
# DB_URL=postgresql://localhost:5432/askme
# DB_URL=postgresql://postgres:encoded_password@localhost:5432/askme
# DB_URL=jdbc:postgresql://localhost:5432/askme
DB_URL=postgresql://localhost:5432/askme
DB_USER=postgres
DB_PASSWORD=
DB_SCHEMA=public
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT_SECONDS=10
# Stops unexpectedly expensive generated queries after 30 seconds.
DB_STATEMENT_TIMEOUT_MS=30000
# Comma-separated defense-in-depth policy restrictions.
RESTRICTED_TABLES=payroll,hr_employees
RESTRICTED_COLUMNS=password,key_secret,ssn,national_id,card_number
# Append-only JSON Lines audit trail, relative to the backend directory.
AUDIT_LOG_PATH=logs/audit.jsonl

# Normal-chat persona used when the request is not a database question.
BOT_SYSTEM_PROMPT=You are AskMe, a concise and helpful assistant for the connected PostgreSQL database. Answer clearly. If you are unsure, say so.
