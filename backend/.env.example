# Application
APP_NAME=AskMe Web
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173
# Optional shared key checked through X-API-Key. Leave empty for no API-key check.
ASKME_API_KEY=
# Return generated SQL in API responses for debugging. Keep false in production.
EXPOSE_SQL=false
# Safe LangGraph node timing/transition logs. Raw questions, SQL, and rows are hashed or omitted.
AGENT_DEBUG=false
MAX_ROWS=50
MAX_HISTORY_TURNS=8
SCHEMA_CACHE_SECONDS=600
# Maximum relevant table schemas sent to the model per attempt.
SCHEMA_MAX_TABLES=8
# Includes the first query plus bounded correction attempts.
SQL_MAX_ATTEMPTS=3
# Persistent validated SQL plans; questions are stored only as SHA-256 hashes.
PLAN_CACHE_PATH=logs/plan_cache.sqlite3
PLAN_CACHE_MAX_ENTRIES=1000

# AI provider: cloudflare or ollama. Restart FastAPI after changing it.
AI_PROVIDER=cloudflare

# Cloudflare Workers AI (used when AI_PROVIDER=cloudflare)
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Legacy fallback used when either specialized model is blank.
CF_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
# SQL planning/generation and bounded SQL correction.
CF_SQL_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
# Metadata explanations, business summaries, general chat, and chart planning.
CF_KNOWLEDGE_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
CF_AI_TEMPERATURE=0.1
CF_AI_TIMEOUT_SECONDS=60

# Ollama (used when AI_PROVIDER=ollama)
# For Docker Compose, use the Ollama service name, for example http://ollama:11434.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Fallback used when either specialized model is blank.
OLLAMA_MODEL=llama3.1:8b
OLLAMA_SQL_MODEL=
OLLAMA_KNOWLEDGE_MODEL=
OLLAMA_AI_TEMPERATURE=0.1
OLLAMA_AI_TIMEOUT_SECONDS=120

# Local PostgreSQL
# Standard, short alias, and JDBC PostgreSQL URLs are accepted.
# Examples:
# DB_URL=postgresql://localhost:5432/askme
# DB_URL=postgresql://postgres:encoded_password@localhost:5432/askme
# DB_URL=jdbc:postgresql://localhost:5432/askme
DB_URL=postgresql://localhost:5432/askme
DB_USER=postgres
DB_PASSWORD=
DB_SCHEMA=core_banking
# Comma-separated schemas users may select. DB_SCHEMA remains the default.
DB_SCHEMAS=accounts,audit_compliance,cards,core_banking,customer360,deposits,digital_banking,fraud_risk,loans,payments
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT_SECONDS=10
# Stops unexpectedly expensive generated queries after 30 seconds.
DB_STATEMENT_TIMEOUT_MS=30000
DB_EXPLAIN_MAX_COST=100000
DB_EXPLAIN_MAX_ROWS=1000000
DB_EXPLAIN_MAX_JOINS=8
# Comma-separated defense-in-depth policy restrictions.
RESTRICTED_TABLES=payroll,hr_employees
RESTRICTED_COLUMNS=password,key_secret,ssn,national_id,card_number
# Append-only JSON Lines audit trail, relative to the backend directory.
AUDIT_LOG_PATH=logs/audit.jsonl

# Normal-chat persona used when the request is not a database question.
BOT_SYSTEM_PROMPT=You are AskMe, a concise and helpful assistant for the connected PostgreSQL database. Answer clearly. If you are unsure, say so.
